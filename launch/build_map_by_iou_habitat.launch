<launch>
  <arg name="scene_name" default="2n8kARJN3HM"/>
  <arg name="path_to_gt_map" default="/home/docker_prism/habitat_data/mp3d_toposlam_validation_scenes/$(arg scene_name)"/>
  <arg name="path_to_save_graph" default="/home/docker_prism/catkin_ws/src/PRISM-TopoMap/graph_results/$(arg scene_name)"/>
  <arg name="path_to_save_logs" default="/home/docker_prism/catkin_ws/src/PRISM-TopoMap/logs"/>
  <arg name="config_file" default="habitat_mp3d_noised_odom.yaml"/>

  <node pkg="prism_topomap" type="prism_topomap_node.py" name="prism_topomap_node" output="screen">
    <param name="path_to_gt_map" value="$(arg path_to_gt_map)"/>
    <param name="path_to_save_graph" value="$(arg path_to_save_graph)"/>
    <param name="config_file" value="$(arg config_file)"/>
  </node>

  <node pkg="prism_topomap" type="tf_manager.py" name="odom_from_tf">
    <param name="source_frame" value="map"/>
    <param name="target_frame" value="base_link"/>
  </node>

  <node pkg="tf" type="static_transform_publisher" name="tf_map_to_odom" args="0 0 0 2.51 0 0 map odom 100"/>
</launch>
